# Cloudflare Pages Environment Variables
# Copy this file to .env and fill in your values

# API Key for backend authentication (must match backend config.json)
# Generate with: openssl rand -hex 32
API_KEY=your_64_character_api_key_here

# Cloudflare KV Namespace ID
# Get this after creating KV namespace: wrangler kv:namespace create STATUS_STORE
STATUS_STORE=your_kv_namespace_id_here
